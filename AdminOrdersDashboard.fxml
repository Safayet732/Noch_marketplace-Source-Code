<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.noch.noch.controllers.AdminOrdersDashboardController"
      spacing="0"
      style="-fx-background-color: #f5f5f5;">

    <!-- PAGE HEADER -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-padding: 0 0 24 0;">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="ORDERS"
                   style="-fx-font-size: 28; -fx-font-weight: bold;
                          -fx-text-fill: #000000; -fx-font-family: Georgia;
                          -fx-letter-spacing: 2;"/>
            <Label text="Manage all customer orders"
                   style="-fx-font-size: 13; -fx-text-fill: #888888;
                          -fx-font-family: Arial;"/>
        </VBox>
        <Button text="+ PLACE NEW ORDER"
                onAction="#goToPlaceOrder"
                style="-fx-background-color: #000000;
                       -fx-text-fill: white;
                       -fx-font-size: 11; -fx-font-weight: bold;
                       -fx-font-family: Arial; -fx-letter-spacing: 2;
                       -fx-background-radius: 0;
                       -fx-padding: 12 20; -fx-cursor: hand;"/>
    </HBox>

    <!-- CARD -->
    <VBox style="-fx-background-color: white;
                 -fx-border-color: #e0e0e0;
                 -fx-border-width: 1;"
          VBox.vgrow="ALWAYS">

        <!-- Card Header -->
        <HBox alignment="CENTER_LEFT"
              style="-fx-padding: 20 24;
                     -fx-border-color: #e0e0e0;
                     -fx-border-width: 0 0 1 0;">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="ALL ORDERS"
                       style="-fx-font-size: 13; -fx-font-weight: bold;
                              -fx-text-fill: #000000; -fx-font-family: Arial;
                              -fx-letter-spacing: 2;"/>
                <Label fx:id="orderCountLabel" text="0 orders found"
                       style="-fx-font-size: 12; -fx-text-fill: #888888;
                              -fx-font-family: Arial;"/>
            </VBox>
        </HBox>

        <!-- Filters -->
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 16 24;
                     -fx-border-color: #e0e0e0;
                     -fx-border-width: 0 0 1 0;">
            <TextField fx:id="searchField"
                       promptText="Search by Order ID, Customer Name..."
                       prefWidth="320"
                       onKeyReleased="#applyFilters"
                       style="-fx-background-color: white;
                              -fx-border-color: #000000;
                              -fx-border-width: 1;
                              -fx-border-radius: 0;
                              -fx-background-radius: 0;
                              -fx-padding: 8 12; -fx-font-size: 12;
                              -fx-font-family: Arial;"/>

            <ComboBox fx:id="customerFilter"
                      promptText="All Customers"
                      prefWidth="180"
                      onAction="#applyFilters"
                      style="-fx-background-radius: 0;
                             -fx-border-color: #cccccc;
                             -fx-font-size: 12; -fx-font-family: Arial;"/>

            <ComboBox fx:id="statusFilter"
                      promptText="All Statuses"
                      prefWidth="160"
                      onAction="#applyFilters"
                      style="-fx-background-radius: 0;
                             -fx-border-color: #cccccc;
                             -fx-font-size: 12; -fx-font-family: Arial;"/>

            <Button text="CLEAR"
                    onAction="#clearFilters"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #888888;
                           -fx-border-color: #cccccc; -fx-border-width: 1;
                           -fx-border-radius: 0; -fx-background-radius: 0;
                           -fx-padding: 8 14; -fx-cursor: hand;
                           -fx-font-size: 11; -fx-font-family: Arial;
                           -fx-letter-spacing: 1;"/>
        </HBox>

        <!-- Table -->
        <TableView fx:id="ordersTable"
                   VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white;
                          -fx-border-color: transparent;">
            <columns>
                <TableColumn fx:id="colOrderId"  text="ORDER ID"   prefWidth="110"/>
                <TableColumn fx:id="colCustomer" text="CUSTOMER"   prefWidth="180"/>
                <TableColumn fx:id="colDate"     text="DATE"       prefWidth="130"/>
                <TableColumn fx:id="colItems"    text="ITEMS"      prefWidth="200"/>
                <TableColumn fx:id="colTotal"    text="TOTAL"      prefWidth="100"/>
                <TableColumn fx:id="colStatus"   text="STATUS"     prefWidth="130"/>
                <TableColumn fx:id="colActions"  text="ACTIONS"    prefWidth="260"/>
            </columns>
            <placeholder>
                <Label text="No orders found"
                       style="-fx-font-size: 13; -fx-text-fill: #888888;
                              -fx-font-family: Arial;"/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
