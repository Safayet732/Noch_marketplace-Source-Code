<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.noch.noch.controllers.CustomerOrderHistoryController"
      spacing="0"
      style="-fx-background-color: #f5f5f5;">

    <!-- PAGE HEADER -->
    <VBox alignment="CENTER" spacing="6"
          style="-fx-padding: 32 48 24 48;
                 -fx-background-color: white;
                 -fx-border-color: #e0e0e0;
                 -fx-border-width: 0 0 1 0;">
        <Label text="MY ORDERS"
               style="-fx-font-size: 32; -fx-font-weight: bold;
                      -fx-text-fill: #000000; -fx-font-family: Georgia;
                      -fx-letter-spacing: 4;"/>
        <Label text="Track and manage your purchases"
               style="-fx-font-size: 13; -fx-text-fill: #888888;
                      -fx-font-family: Arial;"/>
    </VBox>

    <!-- FILTER BAR -->
    <HBox alignment="CENTER_RIGHT" spacing="12"
          style="-fx-padding: 14 48;
                 -fx-background-color: white;
                 -fx-border-color: #e0e0e0;
                 -fx-border-width: 0 0 1 0;">
        <Label fx:id="orderCountLabel" text="0 orders"
               style="-fx-font-size: 12; -fx-text-fill: #888888;
                      -fx-font-family: Arial;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="statusFilter"
                  promptText="All Statuses"
                  prefWidth="160"
                  onAction="#applyFilter"
                  style="-fx-background-radius: 0;
                         -fx-border-color: #e0e0e0; -fx-border-width: 1;
                         -fx-font-size: 12; -fx-font-family: Arial;"/>
    </HBox>

    <!-- TABLE -->
    <VBox VBox.vgrow="ALWAYS"
          style="-fx-padding: 24 48; -fx-background-color: #f5f5f5;">

        <VBox style="-fx-background-color: white;
                     -fx-border-color: #e0e0e0; -fx-border-width: 1;"
              VBox.vgrow="ALWAYS">

            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white;
                              -fx-border-color: transparent;">
                <columns>
                    <TableColumn fx:id="colOrderId" text="ORDER ID"  prefWidth="120"/>
                    <TableColumn fx:id="colDate"    text="DATE"      prefWidth="140"/>
                    <TableColumn fx:id="colItems"   text="ITEMS"     prefWidth="240"/>
                    <TableColumn fx:id="colTotal"   text="TOTAL"     prefWidth="100"/>
                    <TableColumn fx:id="colStatus"  text="STATUS"    prefWidth="130"/>
                    <TableColumn fx:id="colActions" text="ACTIONS"   prefWidth="160"/>
                </columns>
                <placeholder>
                    <Label text="No orders found"
                           style="-fx-font-size: 13; -fx-text-fill: #888888;
                                  -fx-font-family: Arial;"/>
                </placeholder>
            </TableView>
        </VBox>
    </VBox>
</VBox>
