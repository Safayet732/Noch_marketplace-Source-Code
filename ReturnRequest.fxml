<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.noch.noch.controllers.ReturnRequestController"
      spacing="0"
      style="-fx-background-color: #f5f5f5;">

    <!-- BACK + HEADER -->
    <VBox spacing="8" style="-fx-padding: 0 0 24 0;">
        <Button text="← BACK TO ORDER DETAILS" onAction="#goBack"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #888888;
                       -fx-font-size: 11; -fx-font-family: Arial;
                       -fx-letter-spacing: 1; -fx-cursor: hand;
                       -fx-border-width: 0; -fx-underline: true;"/>
        <Label text="RETURN REQUEST"
               style="-fx-font-size: 28; -fx-font-weight: bold;
                      -fx-text-fill: #000000; -fx-font-family: Georgia;
                      -fx-letter-spacing: 2;"/>
        <Label fx:id="orderIdLabel" text="—"
               style="-fx-font-size: 13; -fx-text-fill: #888888;
                      -fx-font-family: Arial;"/>
    </VBox>

    <ScrollPane fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="16" maxWidth="800">

            <!-- SELECT ITEMS -->
            <VBox style="-fx-background-color: white;
                         -fx-border-color: #e0e0e0; -fx-border-width: 1;">
                <VBox spacing="4" style="-fx-padding: 20 24 16 24;
                                          -fx-border-color: #e0e0e0;
                                          -fx-border-width: 0 0 1 0;">
                    <Label text="SELECT ITEMS TO RETURN"
                           style="-fx-font-size: 12; -fx-font-weight: bold;
                                  -fx-text-fill: #000000; -fx-font-family: Arial;
                                  -fx-letter-spacing: 2;"/>
                    <Label text="Choose which pieces you want to return and provide a reason"
                           style="-fx-font-size: 12; -fx-text-fill: #888888;
                                  -fx-font-family: Arial;"/>
                </VBox>
                <VBox fx:id="returnItemsContainer" spacing="0"
                      style="-fx-padding: 16 24;"/>
            </VBox>

            <!-- RETURN DATE -->
            <VBox style="-fx-background-color: white;
                         -fx-border-color: #e0e0e0; -fx-border-width: 1;
                         -fx-padding: 20 24;" spacing="10">
                <Label text="RETURN DATE"
                       style="-fx-font-size: 12; -fx-font-weight: bold;
                              -fx-text-fill: #000000; -fx-font-family: Arial;
                              -fx-letter-spacing: 2;"/>
                <DatePicker fx:id="returnDatePicker" maxWidth="240"
                            style="-fx-background-radius: 0;
                                   -fx-border-color: #000000; -fx-border-width: 1;
                                   -fx-font-size: 13; -fx-font-family: Arial;"/>
            </VBox>

            <!-- ERROR -->
            <Label fx:id="errorLabel" text="" wrapText="true"
                   style="-fx-text-fill: #cc0000; -fx-font-size: 12;
                          -fx-font-family: Arial;"/>

            <!-- BUTTONS -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <padding><Insets bottom="24"/></padding>
                <Button text="CANCEL" onAction="#goBack"
                        style="-fx-background-color: white; -fx-text-fill: #000000;
                               -fx-border-color: #cccccc; -fx-border-width: 1;
                               -fx-border-radius: 0; -fx-background-radius: 0;
                               -fx-padding: 12 24; -fx-cursor: hand;
                               -fx-font-size: 11; -fx-font-family: Arial;
                               -fx-letter-spacing: 1;"/>
                <Button text="SUBMIT RETURN" onAction="#handleSubmit"
                        style="-fx-background-color: #000000; -fx-text-fill: white;
                               -fx-background-radius: 0;
                               -fx-padding: 12 24; -fx-cursor: hand;
                               -fx-font-size: 11; -fx-font-weight: bold;
                               -fx-font-family: Arial; -fx-letter-spacing: 2;"/>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
