<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.noch.noch.controllers.CustomerLayoutController"
      style="-fx-background-color: #f5f5f5;"
      prefWidth="1280" prefHeight="800">

    <!-- TOP NAVBAR -->
    <HBox alignment="CENTER"
          style="-fx-background-color: white;
                 -fx-border-color: #e0e0e0;
                 -fx-border-width: 0 0 1 0;
                 -fx-padding: 0 48;">

        <!-- Left nav -->
        <HBox spacing="0" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <Button fx:id="browseBtn"
                    text="BROWSE"
                    onAction="#goToBrowse"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #000000;
                           -fx-font-size: 11; -fx-font-weight: bold;
                           -fx-font-family: Arial; -fx-letter-spacing: 2;
                           -fx-padding: 20 16;
                           -fx-border-color: transparent transparent #000000 transparent;
                           -fx-border-width: 0 0 2 0;
                           -fx-cursor: hand;"/>
            <Button fx:id="historyBtn"
                    text="MY ORDERS"
                    onAction="#goToOrderHistory"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #888888;
                           -fx-font-size: 11;
                           -fx-font-family: Arial; -fx-letter-spacing: 2;
                           -fx-padding: 20 16;
                           -fx-border-color: transparent;
                           -fx-cursor: hand;"/>
        </HBox>

        <!-- Centre — NOCH logo -->
        <VBox alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS">
            <Label text="NOCH"
                   style="-fx-font-size: 28; -fx-font-weight: bold;
                          -fx-text-fill: #000000; -fx-font-family: Georgia;
                          -fx-letter-spacing: 4;"/>
            <Label text="MINIMALIST ESSENTIALS"
                   style="-fx-font-size: 9; -fx-text-fill: #888888;
                          -fx-font-family: Arial; -fx-letter-spacing: 3;"/>
        </VBox>

        <!-- Right side -->
        <HBox spacing="16" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
            <Label text="ALICE JOHNSON"
                   style="-fx-font-size: 11; -fx-text-fill: #000000;
                          -fx-font-family: Arial; -fx-letter-spacing: 1;"/>
            <Button text="LOGOUT"
                    onAction="#handleLogout"
                    style="-fx-background-color: #000000;
                           -fx-text-fill: white;
                           -fx-font-size: 10; -fx-font-family: Arial;
                           -fx-letter-spacing: 2; -fx-background-radius: 0;
                           -fx-padding: 8 14; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- MAIN CONTENT -->
    <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #f5f5f5;">
        <Label text="Loading..."
               style="-fx-font-size: 14; -fx-text-fill: #888888;"/>
    </StackPane>

</VBox>
