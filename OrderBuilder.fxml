<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.noch.noch.controllers.OrderBuilderController"
      spacing="0"
      style="-fx-background-color: #f5f5f5;">

    <!-- PAGE HEADER -->
    <VBox spacing="4" style="-fx-padding: 0 0 24 0;">
        <Label text="YOUR BAG"
               style="-fx-font-size: 28; -fx-font-weight: bold;
                      -fx-text-fill: #000000; -fx-font-family: Georgia;
                      -fx-letter-spacing: 2;"/>
        <Label text="Review and confirm your order"
               style="-fx-font-size: 13; -fx-text-fill: #888888;
                      -fx-font-family: Arial;"/>
    </VBox>

    <ScrollPane fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="16">

            <!-- ORDER ITEMS -->
            <VBox style="-fx-background-color: white;
                         -fx-border-color: #e0e0e0; -fx-border-width: 1;">

                <VBox spacing="4" style="-fx-padding: 20 24 16 24;
                                          -fx-border-color: #e0e0e0;
                                          -fx-border-width: 0 0 1 0;">
                    <Label text="ORDER ITEMS"
                           style="-fx-font-size: 12; -fx-font-weight: bold;
                                  -fx-text-fill: #000000; -fx-font-family: Arial;
                                  -fx-letter-spacing: 2;"/>
                </VBox>

                <!-- Column headers -->
                <HBox style="-fx-padding: 12 24 8 24;
                             -fx-border-color: #e0e0e0;
                             -fx-border-width: 0 0 1 0;">
                    <Label text="PIECE"     prefWidth="260"
                           style="-fx-font-size:11;-fx-font-weight:bold;-fx-text-fill:#888888;-fx-font-family:Arial;-fx-letter-spacing:1;"/>
                    <Label text="PRICE"     prefWidth="100"
                           style="-fx-font-size:11;-fx-font-weight:bold;-fx-text-fill:#888888;-fx-font-family:Arial;-fx-letter-spacing:1;-fx-alignment:CENTER_RIGHT;"/>
                    <Label text="QUANTITY"  prefWidth="160"
                           style="-fx-font-size:11;-fx-font-weight:bold;-fx-text-fill:#888888;-fx-font-family:Arial;-fx-letter-spacing:1;-fx-alignment:CENTER;"/>
                    <Label text="SUBTOTAL"  prefWidth="100"
                           style="-fx-font-size:11;-fx-font-weight:bold;-fx-text-fill:#888888;-fx-font-family:Arial;-fx-letter-spacing:1;-fx-alignment:CENTER_RIGHT;"/>
                </HBox>

                <VBox fx:id="cartItemsContainer" spacing="0"
                      style="-fx-padding: 0 24;">
                    <Label fx:id="emptyCartLabel"
                           text="Your bag is empty. Go back to browse the collection."
                           style="-fx-font-size: 13; -fx-text-fill: #888888;
                                  -fx-padding: 24 0; -fx-font-family: Arial;"/>
                </VBox>

                <!-- Total -->
                <HBox alignment="CENTER_RIGHT"
                      style="-fx-padding: 16 24;
                             -fx-border-color: #e0e0e0;
                             -fx-border-width: 1 0 0 0;" spacing="16">
                    <Label text="ORDER TOTAL:"
                           style="-fx-font-size: 13; -fx-font-weight: bold;
                                  -fx-text-fill: #888888; -fx-font-family: Arial;
                                  -fx-letter-spacing: 1;"/>
                    <Label fx:id="totalLabel" text="£0.00"
                           style="-fx-font-size: 22; -fx-font-weight: bold;
                                  -fx-text-fill: #000000; -fx-font-family: Georgia;"/>
                </HBox>
            </VBox>

            <!-- Stock Error -->
            <VBox fx:id="stockErrorPanel" visible="false" managed="false"
                  spacing="8"
                  style="-fx-background-color: white;
                         -fx-border-color: #cc0000; -fx-border-width: 1;
                         -fx-padding: 16;">
                <Label text="STOCK ALERT"
                       style="-fx-font-size: 12; -fx-font-weight: bold;
                              -fx-text-fill: #cc0000; -fx-font-family: Arial;
                              -fx-letter-spacing: 2;"/>
                <Label fx:id="stockErrorDetails" text="" wrapText="true"
                       style="-fx-font-size: 13; -fx-text-fill: #cc0000;
                              -fx-font-family: Arial;"/>
                <HBox spacing="12">
                    <Button text="REJECT ORDER" onAction="#handleRejectOrder"
                            style="-fx-background-color: white; -fx-text-fill: #cc0000;
                                   -fx-border-color: #cc0000; -fx-border-width: 1;
                                   -fx-border-radius: 0; -fx-background-radius: 0;
                                   -fx-padding: 8 16; -fx-cursor: hand;
                                   -fx-font-family: Arial; -fx-letter-spacing: 1;"/>
                    <Button text="MARK AS PENDING" onAction="#handleMarkPending"
                            style="-fx-background-color: #000000; -fx-text-fill: white;
                                   -fx-background-radius: 0;
                                   -fx-padding: 8 16; -fx-cursor: hand;
                                   -fx-font-weight: bold; -fx-font-family: Arial;
                                   -fx-letter-spacing: 1;"/>
                </HBox>
            </VBox>

            <!-- BUTTONS -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <padding><Insets bottom="24"/></padding>
                <Button text="CONTINUE SHOPPING" onAction="#continueShopping"
                        style="-fx-background-color: white; -fx-text-fill: #000000;
                               -fx-border-color: #cccccc; -fx-border-width: 1;
                               -fx-border-radius: 0; -fx-background-radius: 0;
                               -fx-padding: 12 24; -fx-cursor: hand;
                               -fx-font-size: 11; -fx-font-family: Arial;
                               -fx-letter-spacing: 1;"/>
                <Button fx:id="confirmBtn" text="CONFIRM ORDER"
                        onAction="#handleConfirmOrder"
                        style="-fx-background-color: #000000; -fx-text-fill: white;
                               -fx-background-radius: 0;
                               -fx-padding: 12 24; -fx-cursor: hand;
                               -fx-font-size: 11; -fx-font-weight: bold;
                               -fx-font-family: Arial; -fx-letter-spacing: 2;"/>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
