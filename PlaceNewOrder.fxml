<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.noch.noch.controllers.PlaceNewOrderController"
      spacing="0"
      style="-fx-background-color: #f5f5f5;">

    <!-- PAGE HEADER -->
    <VBox spacing="4" style="-fx-padding: 0 0 24 0;">
        <Label text="PLACE NEW ORDER"
               style="-fx-font-size: 28; -fx-font-weight: bold;
                      -fx-text-fill: #000000; -fx-font-family: Georgia;
                      -fx-letter-spacing: 2;"/>
        <Label text="Create a new order for a customer"
               style="-fx-font-size: 13; -fx-text-fill: #888888;
                      -fx-font-family: Arial;"/>
    </VBox>

    <ScrollPane fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="16">

            <!-- CUSTOMER INFO -->
            <VBox style="-fx-background-color: white;
                         -fx-border-color: #e0e0e0; -fx-border-width: 1;">
                <VBox spacing="4" style="-fx-padding: 20 24 16 24;
                                          -fx-border-color: #e0e0e0;
                                          -fx-border-width: 0 0 1 0;">
                    <Label text="CUSTOMER INFORMATION"
                           style="-fx-font-size: 12; -fx-font-weight: bold;
                                  -fx-text-fill: #000000; -fx-font-family: Arial;
                                  -fx-letter-spacing: 2;"/>
                </VBox>
                <HBox spacing="16" style="-fx-padding: 20 24 24 24;">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="CUSTOMER NAME *"
                               style="-fx-font-size: 11; -fx-font-weight: bold;
                                      -fx-text-fill: #333333; -fx-font-family: Arial;
                                      -fx-letter-spacing: 1;"/>
                        <TextField fx:id="customerNameField" promptText="John Doe"
                                   style="-fx-background-color: white;
                                          -fx-border-color: #000000; -fx-border-width: 1;
                                          -fx-border-radius: 0; -fx-background-radius: 0;
                                          -fx-padding: 10 12; -fx-font-size: 13;
                                          -fx-font-family: Arial;"/>
                        <Label fx:id="nameError" text=""
                               style="-fx-text-fill: #cc0000; -fx-font-size: 11;
                                      -fx-font-family: Arial;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="CUSTOMER EMAIL *"
                               style="-fx-font-size: 11; -fx-font-weight: bold;
                                      -fx-text-fill: #333333; -fx-font-family: Arial;
                                      -fx-letter-spacing: 1;"/>
                        <TextField fx:id="customerEmailField" promptText="john@example.com"
                                   style="-fx-background-color: white;
                                          -fx-border-color: #000000; -fx-border-width: 1;
                                          -fx-border-radius: 0; -fx-background-radius: 0;
                                          -fx-padding: 10 12; -fx-font-size: 13;
                                          -fx-font-family: Arial;"/>
                        <Label fx:id="emailError" text=""
                               style="-fx-text-fill: #cc0000; -fx-font-size: 11;
                                      -fx-font-family: Arial;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ORDER ITEMS -->
            <VBox style="-fx-background-color: white;
                         -fx-border-color: #e0e0e0; -fx-border-width: 1;">
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 20 24 16 24;
                             -fx-border-color: #e0e0e0;
                             -fx-border-width: 0 0 1 0;">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="ORDER ITEMS"
                               style="-fx-font-size: 12; -fx-font-weight: bold;
                                      -fx-text-fill: #000000; -fx-font-family: Arial;
                                      -fx-letter-spacing: 2;"/>
                    </VBox>
                    <Button text="+ ADD ITEM" onAction="#addLineItem"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #000000;
                                   -fx-border-color: #000000; -fx-border-width: 1;
                                   -fx-border-radius: 0; -fx-background-radius: 0;
                                   -fx-padding: 8 16; -fx-cursor: hand;
                                   -fx-font-size: 11; -fx-font-family: Arial;
                                   -fx-letter-spacing: 1;"/>
                </HBox>

                <HBox style="-fx-padding: 12 24 8 24;
                             -fx-border-color: #e0e0e0;
                             -fx-border-width: 0 0 1 0;">
                    <Label text="PRODUCT" prefWidth="280"
                           style="-fx-font-size: 11; -fx-font-weight: bold;
                                  -fx-text-fill: #888888; -fx-font-family: Arial;
                                  -fx-letter-spacing: 1;"/>
                    <Label text="PRICE" prefWidth="100"
                           style="-fx-font-size: 11; -fx-font-weight: bold;
                                  -fx-text-fill: #888888; -fx-font-family: Arial;
                                  -fx-letter-spacing: 1; -fx-alignment: CENTER_RIGHT;"/>
                    <Label text="QTY" prefWidth="100"
                           style="-fx-font-size: 11; -fx-font-weight: bold;
                                  -fx-text-fill: #888888; -fx-font-family: Arial;
                                  -fx-letter-spacing: 1; -fx-alignment: CENTER;"/>
                    <Label text="SUBTOTAL" prefWidth="100"
                           style="-fx-font-size: 11; -fx-font-weight: bold;
                                  -fx-text-fill: #888888; -fx-font-family: Arial;
                                  -fx-letter-spacing: 1; -fx-alignment: CENTER_RIGHT;"/>
                </HBox>

                <VBox fx:id="lineItemsContainer" spacing="12"
                      style="-fx-padding: 12 24;">
                    <Label fx:id="emptyItemsLabel"
                           text="No items added. Click '+ ADD ITEM' to begin."
                           style="-fx-font-size: 13; -fx-text-fill: #888888;
                                  -fx-padding: 16 0; -fx-font-family: Arial;"/>
                </VBox>

                <HBox alignment="CENTER_RIGHT"
                      style="-fx-padding: 16 24;
                             -fx-border-color: #e0e0e0;
                             -fx-border-width: 1 0 0 0;" spacing="16">
                    <Label text="ORDER TOTAL:"
                           style="-fx-font-size: 13; -fx-font-weight: bold;
                                  -fx-text-fill: #888888; -fx-font-family: Arial;
                                  -fx-letter-spacing: 1;"/>
                    <Label fx:id="totalLabel" text="£0.00"
                           style="-fx-font-size: 22; -fx-font-weight: bold;
                                  -fx-text-fill: #000000; -fx-font-family: Georgia;"/>
                </HBox>
            </VBox>

            <!-- BUTTONS -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <padding><Insets bottom="24"/></padding>
                <Button text="CANCEL" onAction="#handleCancel"
                        style="-fx-background-color: white;
                               -fx-text-fill: #000000;
                               -fx-border-color: #cccccc; -fx-border-width: 1;
                               -fx-border-radius: 0; -fx-background-radius: 0;
                               -fx-padding: 12 24; -fx-cursor: hand;
                               -fx-font-size: 11; -fx-font-family: Arial;
                               -fx-letter-spacing: 1;"/>
                <Button text="CONFIRM ORDER" onAction="#handleSubmit"
                        style="-fx-background-color: #000000;
                               -fx-text-fill: white;
                               -fx-background-radius: 0;
                               -fx-padding: 12 24; -fx-cursor: hand;
                               -fx-font-size: 11; -fx-font-weight: bold;
                               -fx-font-family: Arial; -fx-letter-spacing: 2;"/>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
