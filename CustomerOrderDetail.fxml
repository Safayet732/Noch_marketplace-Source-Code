<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.noch.noch.controllers.CustomerOrderDetailController"
      spacing="0"
      style="-fx-background-color: #f5f5f5;">

    <!-- BACK + HEADER -->
    <VBox spacing="8" style="-fx-padding: 0 0 24 0;">
        <Button text="← BACK TO MY ORDERS" onAction="#goBack"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #888888;
                       -fx-font-size: 11; -fx-font-family: Arial;
                       -fx-letter-spacing: 1; -fx-cursor: hand;
                       -fx-border-width: 0; -fx-underline: true;"/>
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="ORDER DETAILS"
                       style="-fx-font-size: 28; -fx-font-weight: bold;
                              -fx-text-fill: #000000; -fx-font-family: Georgia;
                              -fx-letter-spacing: 2;"/>
                <Label fx:id="orderIdLabel" text="—"
                       style="-fx-font-size: 13; -fx-text-fill: #888888;
                              -fx-font-family: Arial;"/>
            </VBox>
            <Label fx:id="statusBadge" text=""
                   style="-fx-border-width: 1; -fx-padding: 4 12;
                          -fx-font-size: 11; -fx-font-weight: bold;
                          -fx-font-family: Arial; -fx-letter-spacing: 1;"/>
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="16">

            <!-- 3 INFO CARDS -->
            <HBox spacing="16">
                <VBox style="-fx-background-color: white;
                             -fx-border-color: #e0e0e0; -fx-border-width: 1;
                             -fx-padding: 20;" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="CUSTOMER"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #888888; -fx-font-family: Arial;
                                  -fx-letter-spacing: 2;"/>
                    <Label fx:id="customerNameLabel" text="—"
                           style="-fx-font-size: 14; -fx-font-weight: bold;
                                  -fx-text-fill: #000000; -fx-font-family: Arial;"/>
                    <Label fx:id="customerEmailLabel" text="—"
                           style="-fx-font-size: 12; -fx-text-fill: #888888;
                                  -fx-font-family: Arial;"/>
                </VBox>
                <VBox style="-fx-background-color: white;
                             -fx-border-color: #e0e0e0; -fx-border-width: 1;
                             -fx-padding: 20;" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="ORDER DATE"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #888888; -fx-font-family: Arial;
                                  -fx-letter-spacing: 2;"/>
                    <Label fx:id="orderDateLabel" text="—"
                           style="-fx-font-size: 14; -fx-font-weight: bold;
                                  -fx-text-fill: #000000; -fx-font-family: Arial;"/>
                </VBox>
                <VBox style="-fx-background-color: white;
                             -fx-border-color: #e0e0e0; -fx-border-width: 1;
                             -fx-padding: 20;" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="TOTAL AMOUNT"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #888888; -fx-font-family: Arial;
                                  -fx-letter-spacing: 2;"/>
                    <Label fx:id="totalLabel" text="£0.00"
                           style="-fx-font-size: 22; -fx-font-weight: bold;
                                  -fx-text-fill: #000000; -fx-font-family: Georgia;"/>
                </VBox>
            </HBox>

            <!-- ORDER ITEMS -->
            <VBox style="-fx-background-color: white;
                         -fx-border-color: #e0e0e0; -fx-border-width: 1;">
                <VBox spacing="4" style="-fx-padding: 20 24 16 24;
                                          -fx-border-color: #e0e0e0;
                                          -fx-border-width: 0 0 1 0;">
                    <Label text="ORDER ITEMS"
                           style="-fx-font-size: 12; -fx-font-weight: bold;
                                  -fx-text-fill: #000000; -fx-font-family: Arial;
                                  -fx-letter-spacing: 2;"/>
                </VBox>
                <TableView fx:id="itemsTable"
                           style="-fx-background-color: white;
                                  -fx-border-color: transparent; -fx-min-height: 150;">
                    <columns>
                        <TableColumn fx:id="colProduct"   text="PRODUCT"    prefWidth="260"/>
                        <TableColumn fx:id="colUnitPrice" text="UNIT PRICE" prefWidth="120"/>
                        <TableColumn fx:id="colQty"       text="QTY"        prefWidth="80"/>
                        <TableColumn fx:id="colSubtotal"  text="SUBTOTAL"   prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- STATUS TIMELINE -->
            <VBox style="-fx-background-color: white;
                         -fx-border-color: #e0e0e0; -fx-border-width: 1;
                         -fx-padding: 24;" spacing="12">
                <Label text="ORDER STATUS"
                       style="-fx-font-size: 12; -fx-font-weight: bold;
                              -fx-text-fill: #000000; -fx-font-family: Arial;
                              -fx-letter-spacing: 2;"/>
                <HBox fx:id="statusLifecycle" spacing="0" alignment="CENTER"
                      style="-fx-padding: 16 0 8 0;"/>
            </VBox>

            <!-- RETURN BUTTON -->
            <HBox fx:id="returnBtnBox" alignment="CENTER_RIGHT"
                  visible="false" managed="false">
                <padding><Insets bottom="24"/></padding>
                <Button text="REQUEST RETURN" onAction="#requestReturn"
                        style="-fx-background-color: white;
                               -fx-text-fill: #000000;
                               -fx-border-color: #000000; -fx-border-width: 1;
                               -fx-background-radius: 0; -fx-border-radius: 0;
                               -fx-padding: 12 24; -fx-cursor: hand;
                               -fx-font-size: 11; -fx-font-weight: bold;
                               -fx-font-family: Arial; -fx-letter-spacing: 2;"/>
            </HBox>

            <VBox><padding><Insets bottom="24"/></padding></VBox>
        </VBox>
    </ScrollPane>
</VBox>
