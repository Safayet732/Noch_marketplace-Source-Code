<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.noch.noch.controllers.CustomerLookupController"
      spacing="0"
      style="-fx-background-color: #f8fafc;">

    <!-- PAGE HEADER -->
    <VBox spacing="4">
        <padding><Insets bottom="24"/></padding>
        <Label text="Customer Lookup"
               style="-fx-font-size: 28; -fx-font-weight: bold;
                      -fx-text-fill: #0f172a; -fx-font-family: Arial;"/>
        <Label text="Search for customers and view their order history"
               style="-fx-font-size: 13; -fx-text-fill: #64748b; -fx-font-family: Arial;"/>
    </VBox>

    <!-- SEARCH CARD -->
    <VBox style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-border-color: #e2e8f0;
                 -fx-border-width: 1;
                 -fx-border-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
        <padding><Insets bottom="16"/></padding>

        <VBox spacing="4" style="-fx-padding: 20 24 12 24;
                                  -fx-border-color: #f1f5f9;
                                  -fx-border-width: 0 0 1 0;">
            <Label text="Search Customer"
                   style="-fx-font-size: 16; -fx-font-weight: bold;
                          -fx-text-fill: #0f172a; -fx-font-family: Arial;"/>
            <Label text="Search by customer name or ID"
                   style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-font-family: Arial;"/>
        </VBox>

        <VBox spacing="8" style="-fx-padding: 16 24;">
            <Label text="Customer Name or ID"
                   style="-fx-font-size: 13; -fx-font-weight: bold;
                          -fx-text-fill: #374151; -fx-font-family: Arial;"/>
            <HBox spacing="12">
                <TextField fx:id="searchField"
                           promptText="Enter customer name or ID..."
                           HBox.hgrow="ALWAYS"
                           onKeyPressed="#onEnterKey"
                           style="-fx-background-radius: 8;
                                  -fx-border-color: #d1d5db;
                                  -fx-border-radius: 8; -fx-border-width: 1;
                                  -fx-padding: 10 12; -fx-font-size: 13;
                                  -fx-font-family: Arial;"/>
                <Button text="🔍  Search"
                        onAction="#handleSearch"
                        style="-fx-background-color: #002A53;
                               -fx-text-fill: white; -fx-font-size: 13;
                               -fx-font-weight: bold; -fx-background-radius: 8;
                               -fx-padding: 10 20; -fx-cursor: hand;
                               -fx-font-family: Arial;"/>
            </HBox>
        </VBox>

        <!-- Customer Info Panel (shown after search) -->
        <HBox fx:id="customerInfoPanel"
              visible="false" managed="false"
              alignment="CENTER_LEFT"
              style="-fx-background-color: #f8fafc;
                     -fx-background-radius: 8;
                     -fx-border-color: #e2e8f0;
                     -fx-border-width: 1;
                     -fx-border-radius: 8;
                     -fx-padding: 16;
                     -fx-margin: 0 24 16 24;">
            <HBox.margin><Insets left="24" right="24" bottom="16"/></HBox.margin>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="customerNameLabel" text=""
                       style="-fx-font-size: 15; -fx-font-weight: bold;
                              -fx-text-fill: #0f172a; -fx-font-family: Arial;"/>
                <Label fx:id="customerEmailLabel" text=""
                       style="-fx-font-size: 13; -fx-text-fill: #64748b; -fx-font-family: Arial;"/>
                <Label fx:id="customerIdLabel" text=""
                       style="-fx-font-size: 11; -fx-text-fill: #94a3b8; -fx-font-family: Arial;"/>
            </VBox>
            <VBox spacing="2" alignment="CENTER_RIGHT">
                <Label text="Total Orders"
                       style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-font-family: Arial;"/>
                <Label fx:id="orderCountLabel" text="0"
                       style="-fx-font-size: 28; -fx-font-weight: bold;
                              -fx-text-fill: #002A53; -fx-font-family: Arial;"/>
            </VBox>
        </HBox>

        <!-- Not found label -->
        <Label fx:id="notFoundLabel" text="No customer found."
               visible="false" managed="false"
               style="-fx-text-fill: #dc2626; -fx-font-size: 13;
                      -fx-padding: 0 24 16 24; -fx-font-family: Arial;"/>
    </VBox>

    <!-- ORDER HISTORY TABLE (shown after search) -->
    <VBox fx:id="orderHistoryPanel"
          visible="false" managed="false"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-border-color: #e2e8f0;
                 -fx-border-width: 1;
                 -fx-border-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
        <VBox.margin><Insets top="16"/></VBox.margin>

        <VBox spacing="4" style="-fx-padding: 20 24 12 24;
                                  -fx-border-color: #f1f5f9;
                                  -fx-border-width: 0 0 1 0;">
            <Label text="Order History"
                   style="-fx-font-size: 16; -fx-font-weight: bold;
                          -fx-text-fill: #0f172a; -fx-font-family: Arial;"/>
            <Label fx:id="orderHistorySubtitle" text=""
                   style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-font-family: Arial;"/>
        </VBox>

        <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: transparent;
                          -fx-border-color: transparent; -fx-min-height: 200;">
            <columns>
                <TableColumn fx:id="colOrderId"  text="Order ID"   prefWidth="120"/>
                <TableColumn fx:id="colDate"     text="Date"       prefWidth="140"/>
                <TableColumn fx:id="colItems"    text="Items"      prefWidth="160"/>
                <TableColumn fx:id="colTotal"    text="Total"      prefWidth="100"/>
                <TableColumn fx:id="colStatus"   text="Status"     prefWidth="130"/>
                <TableColumn fx:id="colActions"  text="Actions"    prefWidth="140"/>
            </columns>
            <placeholder>
                <Label text="No orders found for this customer"
                       style="-fx-font-size: 14; -fx-text-fill: #94a3b8;"/>
            </placeholder>
        </TableView>
    </VBox>

</VBox>
